<apex:page controller="CalculatorController" sidebar="false" showHeader="false">

<html>
<head>

<style>

body{
    font-family: Arial;
    background:#f4f6f9;
}

.container{
    width:400px;
    margin:80px auto;
    background:white;
    padding:30px;
    border-radius:12px;
    box-shadow:0px 4px 10px rgba(0,0,0,0.2);
}

.title{
    text-align:center;
    font-size:28px;
    font-weight:bold;
    color:#0176d3;
    margin-bottom:25px;
}

.inputBox{
    width:95%;
    padding:10px;
    margin-top:8px;
    margin-bottom:20px;
    border:1px solid #ccc;
    border-radius:6px;
    font-size:16px;
}

.result{
    text-align:center;
    font-size:22px;
    color:green;
    margin-top:20px;
    font-weight:bold;
}

.btn{
    background:#0176d3;
    color:white;
    border:none;
    padding:10px 18px;
    margin:5px;
    border-radius:6px;
    cursor:pointer;
    font-size:15px;
}

.btn:hover{
    background:#014486;
}

.buttonArea{
    text-align:center;
}

</style>

</head>

<body>

<div class="container">

<div class="title">
Simple Calculator
</div>

<apex:form>

    <label>Enter Number 1</label><br/>
    <apex:inputText value="{!num1}" styleClass="inputBox"/>

    <label>Enter Number 2</label><br/>
    <apex:inputText value="{!num2}" styleClass="inputBox"/>

    <div class="buttonArea">

        <apex:commandButton value="Add"
                            action="{!add}"
                            styleClass="btn"/>

        <apex:commandButton value="Subtract"
                            action="{!subtract}"
                            styleClass="btn"/>

        <apex:commandButton value="Multiply"
                            action="{!multiply}"
                            styleClass="btn"/>

        <apex:commandButton value="Divide"
                            action="{!divide}"
                            styleClass="btn"/>

    </div>

    <div class="result">
        Result : {!result}
    </div>

</apex:form>

</div>

</body>
</html>

</apex:page>